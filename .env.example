# Local development: copy needed keys to ignored .dev.vars.
# Production: configure these with Sites runtime environment tools.
# Never put API secrets into browser code or the hosting manifest.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
SOURCE_ALLOWED_HOSTS=dyu.edu.tw,*.dyu.edu.tw
# Optional public R2 custom-domain origin for social services to fetch images.
# Must serve the same BUCKET object keys; private Site URLs are not public media.
PUBLIC_MEDIA_BASE_URL=
# Use a currently supported Meta Graph API version for your application.
META_GRAPH_VERSION=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_USER_ID=
LINE_CHANNEL_TOKEN=
THREADS_USER_ID=
THREADS_TOKEN=
LINKEDIN_TOKEN=
LINKEDIN_AUTHOR=
LINKEDIN_VERSION=
# OAuth user-context token with tweet.write (not app-only bearer token).
X_USER_TOKEN=
