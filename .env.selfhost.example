# Copy to .env.selfhost; keep the actual file private. Node.js >=24.14.
# Use a hostname you control, pointing to the Linux server.
PUBLIC_DOMAIN=social.example.edu.tw
PUBLIC_BASE_URL=https://social.example.edu.tw
ADMIN_EMAIL=
# At least 12 characters; required only when creating/resetting the administrator.
ADMIN_PASSWORD=
PORT=5180
HOST_PORT=5180
HOST=127.0.0.1
# Optional: absolute persistent directory. Default is ./selfhost-data.
# DATA_DIR=/var/lib/campus-social
# CODEX_BIN=/usr/local/bin/codex
EMBEDDED_WORKER=true
# Docker image pins the CLI; update only after revalidating the probe.
CODEX_VERSION=0.166.0

# These can also be entered and encrypted in the administrator's web settings.
# No paid AI request is made unless its feature/provider is explicitly enabled.
OPENAI_API_KEY=
META_GRAPH_VERSION=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
FACEBOOK_APP_SECRET=
INSTAGRAM_USER_ID=
INSTAGRAM_INSIGHTS_TOKEN=
THREADS_USER_ID=
THREADS_TOKEN=
LINE_CHANNEL_TOKEN=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Search is only attempted when the planner supplies suitable public keywords.

# Optional HTTPS bridge for the older Cloudflare workspace. Keep empty for the local EXE.
# CODEX_WEB_BRIDGE_TOKEN=
